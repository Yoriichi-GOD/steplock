STEPLOCK_HOST=127.0.0.1
STEPLOCK_PORT=62327
STEPLOCK_MAX_UPLOAD_MIB=50
STEPLOCK_MAX_VIDEO_SECONDS=120
STEPLOCK_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional for a separately served frontend. Same-origin is the default.
VITE_API_BASE_URL=
# Optional NVIDIA guidance: backend environment only. Never use a VITE_ secret.
ENABLE_NEBIUS_AGENT=0
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_NVIDIA_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_DISABLE_THINKING=1
