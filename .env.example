STEPLOCK_HOST=127.0.0.1
STEPLOCK_PORT=62401
# Windows launcher storage defaults to %LOCALAPPDATA%\STEPLOCK\runtime.
# Set STEPLOCK_RUNTIME explicitly only when selecting another storage directory.
STEPLOCK_MAX_UPLOAD_MIB=50
STEPLOCK_MAX_VIDEO_SECONDS=120
STEPLOCK_ALLOWED_ORIGINS=http://localhost:62401,http://127.0.0.1:62401
# Optional for a separately served frontend. Same-origin is the default.
VITE_API_BASE_URL=
# Optional NVIDIA guidance: backend environment only. Never use a VITE_ secret.
ENABLE_NEBIUS_AGENT=0
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_NVIDIA_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_DISABLE_THINKING=1
# Public hosting is a separate, restricted mode. No owner key/contact is bundled.
STEPLOCK_PUBLIC_MODE=0
STEPLOCK_TRUSTED_HOSTS=127.0.0.1,localhost
STEPLOCK_OWNER_KEY=
STEPLOCK_PUBLIC_CONTACT=
# Trust only the actual reverse-proxy addresses in a hosted launch. Never use '*'.
FORWARDED_ALLOW_IPS=127.0.0.1
