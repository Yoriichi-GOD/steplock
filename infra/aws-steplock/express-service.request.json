{
  "serviceName": "steplock-prelaunch",
  "cluster": "${DEDICATED_STEPLOCK_CLUSTER_ARN}",
  "executionRoleArn": "${DEDICATED_STEPLOCK_EXECUTION_ROLE_ARN}",
  "infrastructureRoleArn": "${DEDICATED_STEPLOCK_INFRASTRUCTURE_ROLE_ARN}",
  "cpu": "1024",
  "memory": "2048",
  "cpuArchitecture": "X86_64",
  "healthCheckPath": "/api/health",
  "networkConfiguration": {
    "subnets": ["${DEDICATED_STEPLOCK_SUBNET_A}", "${DEDICATED_STEPLOCK_SUBNET_B}"]
  },
  "primaryContainer": {
    "image": "${VERIFIED_STEPLOCK_ECR_IMAGE_AT_SHA256_DIGEST}",
    "containerPort": 8000,
    "awsLogsConfiguration": {
      "logGroup": "/steplock/prelaunch",
      "logStreamPrefix": "inspection"
    },
    "environment": [
      {"name": "STEPLOCK_PUBLIC_MODE", "value": "1"},
      {"name": "STEPLOCK_TRUSTED_HOSTS", "value": "127.0.0.1,localhost"},
      {"name": "STEPLOCK_PUBLIC_CONTACT", "value": ""},
      {"name": "ENABLE_NEBIUS_AGENT", "value": "0"},
      {"name": "FORWARDED_ALLOW_IPS", "value": "${DEDICATED_ALB_SUBNET_CIDRS_ONLY}"}
    ]
  },
  "scalingTarget": {"minTaskCount": 1, "maxTaskCount": 1},
  "tags": [
    {"key": "Project", "value": "STEPLOCK"},
    {"key": "Environment", "value": "prelaunch"},
    {"key": "ExpiresAt", "value": "${APPROVED_UTC_TEARDOWN_TIME}"}
  ]
}
